# ==========================================================================
# Supabase — copiez ce fichier vers .env.local et renseignez vos valeurs
# (Tableau de bord Supabase > Project Settings > API)
# ==========================================================================

# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique "anon" (sûre côté navigateur — protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé "service_role" (SECRÈTE — serveur uniquement, jamais exposée au client)
# Utilisée par les actions admin : création d'utilisateurs, réinitialisation
# des mots de passe. NE JAMAIS préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Domaine synthétique interne pour l'authentification par nom d'utilisateur.
# Les comptes sont stockés sous la forme <username>@<ce-domaine> dans
# Supabase Auth. Les commerciaux ne voient jamais cette adresse.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=crm.local

# ==========================================================================
# Assistant IA (OpenAI) — clé secrète, serveur uniquement.
# platform.openai.com > API keys. Sans cette clé, l'assistant répond 503
# et le reste de l'app fonctionne normalement.
# ==========================================================================
OPENAI_API_KEY=sk-...
# Optionnel : surcharger les modèles par défaut
# AI_MODEL_FIELD=gpt-5.6-luna
# AI_MODEL_ANALYSIS=gpt-5.6-terra
# AI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
